			"height": 480,
			"label": "Common Data Preprocessing (RoNIN Loader)"
		},
		{
			"id": "node_raw_imu",
			"type": "text",
			"text": "## Raw Input\n**Format**: Raw IMU\n**Frame**: Body Frame\n**Content**: Gyro + Accel",
			"styleAttributes": {},
			"x": -600,
			"y": -100,
			"width": 250,
			"height": 140
		},
		{
			"id": "node_alignment",
			"type": "text",
			"text": "## Coordinate Alignment\n\n1. Load Device Orientation\n2. Rotate Body Frame -> **Global Frame**\n3. Result is **Gravity Aligned**\n4. Heading Agnostic",
			"styleAttributes": {},
			"x": -280,
			"y": -120,
			"width": 300,
			"height": 180
		},
		{
			"id": "node_global_imu",
			"type": "text",
			"text": "## Global IMU Feature\n\n**Shape**: `(B, 6, T)`\n**Channels**: \n- 3x Global Gyro\n- 3x Global Accel\n**T**: Window Size (e.g., 200)",
			"styleAttributes": {
				"shape": "parallelogram"
			},
			"x": 160,
			"y": -60,
			"width": 280,
			"height": 180
		},
		{
			"id": "group_scheme1",
			"type": "group",
			"styleAttributes": {},
			"x": 600,
			"y": -400,
			"width": 800,
			"height": 450,
			"label": "Scheme 1: Cascade (RoNIN + Diffusion)"
		},
		{
			"id": "node_ronin_model",
			"type": "text",
			"text": "## RoNIN Model\n(ResNet18)\n\n**Role**: Prior Estimator",
			"styleAttributes": {},
			"x": 640,
			"y": -360,
			"width": 200,
			"height": 100
		},
		{
			"id": "node_ronin_out",
			"type": "text",
			"text": "**Output**: `(B, 2)`\nAvg Velocity $(v_x, v_y)$",
			"styleAttributes": {},
			"x": 900,
			"y": -360,
			"width": 200,
			"height": 80
		},
		{
			"id": "node_broadcast",
			"type": "text",
			"text": "## Broadcast & Concat\n\n1. Expand `(B, 2)` -> `(B, 2, T)`\n2. Concat with IMU `(B, 6, T)`",
			"styleAttributes": {},
			"x": 900,
			"y": -240,
			"width": 240,
			"height": 100
		},
		{
			"id": "node_cond_s1",
			"type": "text",
			"text": "## Condition Tensor\n\n**Shape**: `(B, 8, T)`\n- 6 ch: Global IMU\n- 2 ch: RoNIN Prior (Global)",
			"styleAttributes": {
				"color": "4"
			},
			"x": 1180,
			"y": -240,
			"width": 200,
			"height": 140
		},
		{
