		{
			"id": "node_cond_s2",
			"type": "text",
			"text": "## Condition Tensor\n\n**Shape**: `(B, 6, T)`\n- 6 ch: Global IMU (Direct)",
			"styleAttributes": {
				"color": "5"
			},
			"x": 700,
			"y": 180,
			"width": 240,
			"height": 120
		},
		{
			"id": "node_unet",
